# PostgreSQL/PostGIS local Docker environment
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and must never be committed.

POSTGRES_DB=safety_hiking
POSTGRES_USER=safety_hiking_app
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Used by backend/src/main/resources/application.properties when running Spring Boot
# locally against the Dockerized PostgreSQL above.
DB_HOST=localhost
